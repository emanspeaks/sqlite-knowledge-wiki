# Copy to .env and edit. .env is git-ignored; never commit a filled-in copy.
# Booleans accept 1/true/yes/on (anything else is false).

# ---------------------------------------------------------------- Site
# Public URL of the wiki as users see it through the reverse proxy. REQUIRED.
MW_SERVER=https://wiki.example.org
MW_SITE_NAME=Team Wiki
# URL path the wiki is served under. Empty = site root. Example: /w
MW_SCRIPT_PATH=
MW_LANG=en
MW_TIMEZONE=UTC
# vector-2022, vector, monobook, timeless or minerva
MW_SKIN=vector-2022
# Optional logo URLs (defaults to MediaWiki's placeholder).
#MW_LOGO=
#MW_LOGO_ICON=
# Reverse proxies whose X-Forwarded-For is trusted, comma-separated IPs/CIDRs.
#MW_TRUSTED_PROXIES=172.16.0.0/12

# ---------------------------------------------------------------- First run only
# Used once, when the database file does not exist yet. Ignored afterwards.
MW_ADMIN_USER=Admin
# At least 10 characters. Alternatively point MW_ADMIN_PASSWORD_FILE at a file
# inside the container (e.g. a Docker secret).
MW_ADMIN_PASSWORD=
#MW_ADMIN_PASSWORD_FILE=/run/secrets/wiki_admin_password

# ---------------------------------------------------------------- Storage
# Main database is <MW_DATA_DIR>/<MW_DB_NAME>.sqlite.
MW_DB_NAME=wiki
# Path inside the container. If you change it, change the wiki-data volume
# mount in docker-compose.yml to match.
MW_DATA_DIR=/var/www/data

# ---------------------------------------------------------------- Secrets
# Optional. If unset, a key is generated on first run and persisted in
# <MW_DATA_DIR>/secret.key.
#MW_SECRET_KEY=

# ---------------------------------------------------------------- Access
# true = login required to read.
MW_PRIVATE=false
# true = visitors may create their own accounts.
MW_ALLOW_REGISTRATION=false
# true = editing without an account (ignored when MW_PRIVATE=true).
MW_ALLOW_ANON_EDIT=false
# Any non-empty text puts the wiki in read-only mode and is shown to editors.
# Also skips update.php on start and pauses the job runner.
#MW_READ_ONLY=Read-only snapshot

# ---------------------------------------------------------------- Features
MW_ENABLE_UPLOADS=false
MW_ENABLE_EMAIL=false
# Sender address and SMTP relay, used only when MW_ENABLE_EMAIL=true.
#MW_EMAIL_SENDER=wiki@example.org
#MW_SMTP_HOST=smtp.example.org
#MW_SMTP_PORT=587
#MW_SMTP_USER=
#MW_SMTP_PASSWORD=
# Bundled extensions to load (directory names under extensions/), comma-separated.
# Available: AbuseFilter CategoryTree Cite CiteThisPage CodeEditor ConfirmEdit
# DiscussionTools Echo Gadgets ImageMap InputBox Interwiki Linter LoginNotify
# Math MultimediaViewer Nuke OATHAuth PageImages ParserFunctions PdfHandler Poem
# ReplaceText Scribunto SecureLinkFixer SpamBlacklist SyntaxHighlight_GeSHi
# TemplateData TextExtracts Thanks TitleBlacklist VisualEditor WikiEditor
MW_EXTENSIONS=Cite,ParserFunctions,WikiEditor,CodeEditor,SyntaxHighlight_GeSHi,VisualEditor,TemplateData,CategoryTree,Interwiki,Nuke,ReplaceText,Scribunto,Math
MW_ENABLE_SMW=true
MW_ENABLE_WIKIBASE=true

# ---------------------------------------------------------------- Wikibase
# Namespace names for Wikibase entities (IDs 120 and 122). The property
# namespace must not be "Property": that name belongs to Semantic MediaWiki.
WB_ITEM_NAMESPACE=Item
WB_PROPERTY_NAMESPACE=WbProperty

# ---------------------------------------------------------------- Operations
# Jobs run per page view. Keep 0 while the jobrunner service is running;
# set 1 if you run the wiki container alone.
MW_JOB_RUN_RATE=0
# Seconds the jobrunner sleeps between passes.
MW_JOB_INTERVAL=10
# Run update.php --quick on every start (needed after image upgrades).
MW_AUTO_UPDATE=true
# Show exception details and PHP errors in responses. Not for production.
MW_DEBUG=false

# ---------------------------------------------------------------- Compose / build
# Host address:port the wiki is published on.
WIKI_BIND=127.0.0.1:8080
# Build arguments.
#MEDIAWIKI_IMAGE=mediawiki:1.43
#SMW_VERSION=~7.4
#WIKIBASE_BRANCH=REL1_43
